{
  "schema_version": 1,
  "release_version": "v5.3.210-p1.5",
  "purpose": "Сократить когнитивную нагрузку и сделать следующий осмысленный шаг очевидным, не удаляя профессиональные возможности.",
  "stages": [
    {
      "id": "profile",
      "number": 1,
      "label": "Потребности",
      "short_label": "Профиль",
      "target": "#needs",
      "completion_signal": "#normInput-kcal contains a positive value"
    },
    {
      "id": "ration",
      "number": 2,
      "label": "Собрать рацион",
      "short_label": "Рацион",
      "target": "#globalSearchSection",
      "completion_signal": "#rationBody contains at least one positive ration row"
    },
    {
      "id": "analysis",
      "number": 3,
      "label": "Понять результат",
      "short_label": "Анализ",
      "target": "#totalsSection",
      "requires": [
        "ration"
      ]
    },
    {
      "id": "action",
      "number": 4,
      "label": "Улучшить и сохранить",
      "short_label": "Действия",
      "target": "#globalActions",
      "requires": [
        "ration"
      ]
    }
  ],
  "progressive_disclosure": {
    "requires_ration": [
      "#p15ResultOverview",
      "#p15CoreResults",
      "#p15AdvancedAnalysis",
      "#p15AiPlannerDrawer",
      "#globalActions"
    ],
    "optional_drawers": [
      {
        "id": "p15AlternativeInput",
        "label": "Другие способы добавить рацион",
        "contains": [
          "#geminiRationImportSection"
        ]
      },
      {
        "id": "p15AdvancedAnalysis",
        "label": "Расширенный анализ и методика",
        "contains": [
          "#dietAnalysisProfilePanel",
          "#dataQualityPanel"
        ]
      },
      {
        "id": "p15AiPlannerDrawer",
        "label": "ИИ-помощник по перестройке рациона",
        "contains": [
          "#geminiAiSection"
        ]
      }
    ],
    "primary_result_drawer": {
      "id": "p15CoreResults",
      "label": "Основной итог рациона",
      "contains": [
        "#totalsSection",
        "#heiPanel"
      ],
      "default_open": false,
      "summary_surface": "#p15ResultOverview"
    }
  },
  "decision_rules": [
    {
      "id": "calculate-needs",
      "when": "needs are not calculated",
      "message": "Сначала рассчитайте ориентиры потребностей — это сделает сравнение рациона содержательным.",
      "action_label": "Рассчитать потребности",
      "target": "#needs"
    },
    {
      "id": "add-first-product",
      "when": "needs are calculated and ration is empty",
      "message": "Ориентиры готовы. Добавьте первый продукт через быстрый поиск.",
      "action_label": "Добавить первый продукт",
      "target": "#globalSearchInput"
    },
    {
      "id": "review-results",
      "when": "ration contains products",
      "message": "Рацион собран. Сначала проверьте итоговые нутриенты и главные отклонения, затем переходите к расширенному анализу.",
      "action_label": "Посмотреть итог",
      "target": "#totalsSection"
    }
  ],
  "accessibility": {
    "navigation_label": "Этапы работы с калькулятором",
    "live_region": true,
    "keyboard_targets": true,
    "minimum_pointer_target_css_px": 44,
    "do_not_remove_existing_controls": true
  }
}
